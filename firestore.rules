rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User data — only the owner can read/write
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /sessions/{sid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /usage/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Anonymous quota tracking — managed by Admin SDK only
    match /anonymous_usage/{docId} {
      allow read, write: if false;
    }

    // Training records — managed by Admin SDK only
    match /analytics_training/{docId} {
      allow read, write: if false;
    }

    // Calibration config — authenticated users can read (needed by client), only admin SDK can write
    match /calibration_config/{docId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
  }
}
